# ============================================================
# AI Placement Assistance Platform - environment configuration
# Copy this file to ".env" (same folder, project root) and fill in what you need.
# Nothing here is required to get started: the app works fully offline with
# Ollama out of the box.
# ============================================================

# ---------- LLM engine ----------
# LLM_BACKEND controls how the app picks its AI engine:
#   auto   -> use Groq (cloud) when GROQ_API_KEY is set and reachable,
#             automatically fall back to local Ollama otherwise. (Recommended)
#   ollama -> always use the local Ollama server, never call the cloud.
#   groq   -> always use Groq, never fall back to Ollama.
LLM_BACKEND=auto

# Local engine (free, offline, no signup): https://ollama.com
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Cloud engine (free tier, optional, needs internet): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---------- Speech-to-text (Mock Interview module) ----------
# STT_BACKEND: auto | local | groq
#   auto  -> use Groq Whisper (cloud, fast) when GROQ_API_KEY is set, else local
#   local -> always use local faster-whisper (fully offline)
STT_BACKEND=auto
WHISPER_MODEL_SIZE=small
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# ---------- Text-to-speech (Mock Interview module) ----------
# TTS_BACKEND: pyttsx3 (offline, default) | edge (online, higher quality)
TTS_BACKEND=pyttsx3
EDGE_TTS_VOICE=en-US-GuyNeural

# ---------- Roadmap Generator: optional AI-illustrated image (extra, off by default) ----------
# The roadmap's downloadable image is always generated locally/offline (a
# Pillow-rendered timeline infographic) - this section is a purely optional
# ADD-ON that, if configured, offers a second "AI-illustrated" image option
# generated via an OpenAI-compatible image endpoint (e.g. OpenAI's own
# gpt-image-1/dall-e-3). Leave IMAGE_GEN_API_KEY blank to keep this feature
# hidden entirely and stay 100% free/offline for roadmap images.
IMAGE_GEN_API_KEY=
IMAGE_GEN_BASE_URL=https://api.openai.com/v1
IMAGE_GEN_MODEL=gpt-image-1

# ---------- Server ----------
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# ---------- Live AI Interview (voice-first, WebSocket) ----------
# No new provider/secret needed - reuses the same LLM/STT/TTS engines above
# over a persistent WebSocket instead of request/response. Barge-in/turn
# detection runs entirely in the browser via @ricky0123/vad-web (client-side
# ONNX Silero VAD, MIT licensed, zero server cost).
LIVE_INTERVIEW_ENABLED=true
LIVE_INTERVIEW_MAX_DURATION_SECS=1800
LIVE_INTERVIEW_IDLE_TIMEOUT_SECS=120
LIVE_INTERVIEW_MAX_CONCURRENT_PER_STUDENT=1

# ---------- Misc ----------
APP_TITLE=AI Placement Assistance Platform
DEPARTMENT_NAME=Department of Computer Science and Engineering
